<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- SDK Windows 22621 pour les API WinRT (Appx, radios, UISettings) ; exécutable dès Windows 10 2004. -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Timonier</RootNamespace>
    <AssemblyName>Timonier</AssemblyName>
    <StartupObject>Timonier.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Timonier.ico</ApplicationIcon>
    <Product>Timonier</Product>
    <Company>Spik</Company>
    <Authors>Spik</Authors>
    <Copyright>Copyright (C) 2026 Spik - GPL-3.0</Copyright>
    <RepositoryUrl>https://github.com/Thespiki/Timonier</RepositoryUrl>
    <Description>Local control center for Windows</Description>
    <Version>0.1.0</Version>
    <NeutralLanguage>fr-FR</NeutralLanguage>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>

    <!-- Empreinte minimale : GC non concurrent (pas de thread GC d'arrière-plan), PGO dynamique. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>

    <!-- WPF0001 : ThemeMode (Fluent) est encore marqué expérimental. -->
    <NoWarn>$(NoWarn);WPF0001;NU1510;CA1416;WFO0003</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms n'est utilisé que pour l'icône de la zone de notification : on évite les conflits de noms avec WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Timonier.ico" />
    <Resource Include="Assets\Timonier.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Traductions : une ressource par langue, chargée seulement si elle est active (voir Core/Localization/Loc.cs). -->
    <EmbeddedResource Include="Localization\*.json" Exclude="Localization\_*.json" LogicalName="Localization/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.12" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="10.0.12" />
    <PackageReference Include="System.Management" Version="10.0.12" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.12" />
  </ItemGroup>

</Project>
