<UserControl x:Class="Timonier.UI.Controls.TweakCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Timonier.Core.Localization">
    <Border x:Name="Root">
        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Pp.CardInteractive}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Pp.Accent}" />
                        <Setter Property="BorderThickness" Value="2" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Pp.CardTitle}" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource Pp.Caption}" Margin="0,2,0,0" />

                <ItemsControl ItemsSource="{Binding Badges}" Margin="0,6,0,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Pp.Badge}" Margin="0,2,6,2" ToolTip="{Binding Tooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Pp.Icon}" FontSize="10" Text="{Binding Glyph}" Margin="0,0,4,0"
                                               Foreground="{DynamicResource Pp.Neutral}" />
                                    <TextBlock Style="{StaticResource Pp.BadgeText}" Text="{Binding Text}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <DockPanel Margin="0,4,0,0" Visibility="{Binding UnavailableReason, Converter={StaticResource StringToVisibility}}">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Pp.Icon}" FontSize="12" Text="&#xE946;" Foreground="{DynamicResource Pp.Warning}"
                               Margin="0,1,6,0" VerticalAlignment="Top" />
                    <TextBlock Style="{StaticResource Pp.Caption}" Text="{Binding UnavailableReason}" Foreground="{DynamicResource Pp.Warning}" TextWrapping="Wrap" />
                </DockPanel>

                <TextBlock Style="{StaticResource Pp.Caption}" Text="{Binding StateText}" Foreground="{DynamicResource Pp.TextTertiary}" Margin="0,4,0,0"
                           Visibility="{Binding StateText, Converter={StaticResource StringToVisibility}}" />

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                            Visibility="{Binding RecommendationText, Converter={StaticResource StringToVisibility}}">
                    <TextBlock Style="{StaticResource Pp.Icon}" FontSize="12" Text="&#xE734;" Foreground="{DynamicResource Pp.AccentText}" Margin="0,0,6,0" />
                    <TextBlock Style="{StaticResource Pp.Caption}" Text="{Binding RecommendationText}" Foreground="{DynamicResource Pp.AccentText}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource Pp.LinkButton}" Content="{loc:L 'Appliquer'}" Margin="8,0,0,0" Command="{Binding ApplyRecommendedCommand}"
                            IsEnabled="{Binding CanInteract}" />
                </StackPanel>

                <Button Style="{StaticResource Pp.LinkButton}" HorizontalAlignment="Left" Margin="-2,6,0,0" Command="{Binding ToggleDetailsCommand}"
                        ToolTip="{loc:L 'Liste exacte des modifications effectuées par ce réglage'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Pp.Icon}" FontSize="10" Text="&#xE946;" Foreground="{DynamicResource Pp.AccentText}" Margin="0,0,4,0" />
                        <TextBlock Text="{loc:L 'Ce que ça change'}" />
                    </StackPanel>
                </Button>

                <Border Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0" Padding="10,8"
                        CornerRadius="6" Background="{DynamicResource Pp.CardSecondary}">
                    <StackPanel>
                        <TextBlock Text="{Binding DetailsText}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                   Foreground="{DynamicResource Pp.TextSecondary}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Warning}" Style="{StaticResource Pp.Caption}" Foreground="{DynamicResource Pp.Warning}" Margin="0,8,0,0"
                                   Visibility="{Binding Warning, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,0,0">
                <ProgressBar IsIndeterminate="True" Width="40" Height="3" Margin="0,0,12,0" VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel Orientation="Horizontal" Visibility="{Binding IsToggle, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ToggleLabel}" Style="{StaticResource Pp.Body}" VerticalAlignment="Center" Margin="0,0,12,0"
                               Foreground="{DynamicResource Pp.TextSecondary}" />
                    <CheckBox Style="{StaticResource Pp.ToggleSwitch}" IsThreeState="False" IsChecked="{Binding IsOn, Mode=TwoWay}"
                              IsEnabled="{Binding CanInteract}" AutomationProperties.Name="{Binding Title}" />
                </StackPanel>

                <ComboBox MinWidth="200" ItemsSource="{Binding Options}" DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedOption, Mode=TwoWay}" IsEnabled="{Binding CanInteract}"
                          Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding Title}" />

                <Button Style="{StaticResource Pp.Button}" Content="{Binding ActionLabel}" Command="{Binding RunCommand}"
                        IsEnabled="{Binding CanInteract}" Visibility="{Binding IsAction, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
