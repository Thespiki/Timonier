<Window x:Class="Timonier.UI.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Timonier.Core.Localization"
        Title="Timonier" Width="1200" Height="800" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource Pp.TextFont}">
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="288" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================ Navigation -->
        <DockPanel Grid.Column="0" Margin="10,10,6,10" Background="{DynamicResource Pp.NavBackground}">
            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" Margin="12,4,0,14">
                    <Image Source="/Assets/Timonier.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />

                    <TextBlock Text="Timonier" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Pp.TextPrimary}" />
                </StackPanel>

                <!-- Carte d'identité du PC -->
                <Border x:Name="PcCard" Style="{StaticResource Pp.CardInteractive}" Margin="4,0,4,10" Padding="12,10" Cursor="Hand"
                        MouseLeftButtonUp="PcCard_Click" ToolTip="{loc:L 'Overview of this PC'}">
                    <StackPanel>
                        <TextBlock x:Name="PcName" FontWeight="SemiBold" Foreground="{DynamicResource Pp.TextPrimary}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PcModel" Style="{StaticResource Pp.Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <TextBlock x:Name="PcWindows" Style="{StaticResource Pp.Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                </Border>

                <TextBox x:Name="SearchBox" Style="{StaticResource Pp.SearchBox}" Margin="4,0,4,8" MaxLength="200"
                         Tag="{loc:L 'Search (Ctrl+K)…'}" AutomationProperties.Name="{loc:L 'Search'}"
                         TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" GotKeyboardFocus="SearchBox_GotFocus" />
            </StackPanel>

            <!-- Pied de navigation : session admin -->
            <StackPanel DockPanel.Dock="Bottom" Margin="4,6,4,0">
                <Border x:Name="AdminBar" Style="{StaticResource Pp.InfoBar.Warning}" Visibility="Collapsed" Margin="0,0,0,6" Padding="10,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Pp.LinkButton}" Content="{loc:L 'Close'}" Click="CloseAdmin_Click"
                                ToolTip="{loc:L 'Close the admin session now'}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Pp.Icon}" Text="&#xE7EF;" FontSize="14" Margin="0,0,8,0" DockPanel.Dock="Left" />
                        <TextBlock x:Name="AdminText" Style="{StaticResource Pp.Caption}" Foreground="{DynamicResource Pp.TextPrimary}"
                                   Text="{loc:L 'Admin session active'}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <Border x:Name="RebootBar" Style="{StaticResource Pp.InfoBar}" Visibility="Collapsed" Margin="0,0,0,6" Padding="10,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Pp.LinkButton}" Content="{loc:L 'Restart'}" Click="Reboot_Click" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Pp.Icon}" Text="&#xE777;" FontSize="14" Margin="0,0,8,0" DockPanel.Dock="Left" />
                        <TextBlock Style="{StaticResource Pp.Caption}" Foreground="{DynamicResource Pp.TextPrimary}"
                                   Text="{loc:L 'Restart required to finish'}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel x:Name="NavHost" Margin="4,0,4,0" />
            </ScrollViewer>
        </DockPanel>

        <!-- ============================================================ Contenu -->
        <Border Grid.Column="1" Background="{DynamicResource Pp.ContentBackground}" BorderBrush="{DynamicResource Pp.ContentBorder}"
                BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <ContentControl x:Name="PageHost" Focusable="False" />
        </Border>

        <!-- ============================================================ Résultats de recherche -->
        <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" VerticalOffset="4"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
            <Border Width="580" MaxHeight="520" Background="{DynamicResource Pp.CardBackground}" BorderBrush="{DynamicResource Pp.ControlStroke}"
                    BorderThickness="1" CornerRadius="8" Padding="0,6" Margin="0,0,12,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.25" />
                </Border.Effect>
                <DockPanel>
                    <TextBlock x:Name="SearchHint" DockPanel.Dock="Bottom" Style="{StaticResource Pp.Caption}" Margin="14,6,14,2"
                               Foreground="{DynamicResource Pp.TextTertiary}"
                               Text="{loc:L '↑↓ to navigate · Enter to open · Esc to close'}" />
                    <ListBox x:Name="SearchResults" BorderThickness="0" Background="Transparent" Focusable="False"
                             ItemContainerStyle="{StaticResource Pp.ResultItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseLeftButtonUp="SearchResults_Click" />
                </DockPanel>
            </Border>
        </Popup>

        <!-- ============================================================ Notifications (toasts) -->
        <StackPanel x:Name="ToastHost" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Width="420" />

        <!-- ============================================================ Boîtes de dialogue -->
        <Grid x:Name="DialogLayer" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{DynamicResource Pp.Overlay}">
            <Border x:Name="DialogCard" Width="520" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource Pp.CardBackground}" BorderBrush="{DynamicResource Pp.ControlStroke}" BorderThickness="1" CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.3" />
                </Border.Effect>
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Pp.CardSecondary}" CornerRadius="0,0,8,8" Padding="24,16">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="DialogPrimary" MinWidth="120" Margin="0,0,8,0" Click="DialogPrimary_Click" IsDefault="True" />
                            <Button x:Name="DialogSecondary" Style="{StaticResource Pp.Button}" MinWidth="120" Click="DialogSecondary_Click" IsCancel="True" />
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="24,22,24,18">
                        <TextBlock x:Name="DialogTitle" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Pp.TextPrimary}"
                                   TextWrapping="Wrap" Margin="0,0,0,12" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="440" Focusable="False">
                            <ContentControl x:Name="DialogContent" Focusable="False" />
                        </ScrollViewer>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============================================================ Verrouillage par code -->
        <Grid x:Name="LockLayer" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{DynamicResource Pp.WindowBackground}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">
                <TextBlock Style="{StaticResource Pp.Icon}" Text="&#xE72E;" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,16" />
                <TextBlock Text="{loc:L 'Timonier is protected'}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Pp.TextPrimary}" />
                <TextBlock Text="{loc:L 'Enter the code you set in settings.'}" Style="{StaticResource Pp.Caption}" HorizontalAlignment="Center"
                           Margin="0,4,0,16" />
                <PasswordBox x:Name="LockPin" Height="34" FontSize="16" KeyDown="LockPin_KeyDown" />
                <TextBlock x:Name="LockError" Style="{StaticResource Pp.Caption}" Foreground="{DynamicResource Pp.Danger}" Margin="0,6,0,0" />
                <Button Content="{loc:L 'Unlock'}" Style="{StaticResource Pp.AccentButton}" Margin="0,12,0,0" Click="Unlock_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
