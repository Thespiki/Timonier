<Project Sdk="Microsoft.NET.Sdk">

  <!-- Outil de développement (non livré) : extraction et vérification des textes traduisibles. Voir docs/I18N.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>I18nTool</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mêmes règles de pluriel et même liste de langues que l'application. -->
    <Compile Include="..\..\src\Timonier\Core\Localization\PluralRules.cs" Link="Shared\PluralRules.cs" />
    <Compile Include="..\..\src\Timonier\Core\Localization\Languages.cs" Link="Shared\Languages.cs" />
  </ItemGroup>

</Project>
